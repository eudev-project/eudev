(( $+functions[_udevadm_info] )) ||
_udevadm_info(){
    _arguments \
        '(-)'{-h,--help}'[Print help]' \
        '(-)'{-V,--version}'[Print version of the program]' \
        '--query=[Query the database for specified type of device data. It needs the --path or --name to identify the specified device.]:type:(name symlink path property all)' \
        '*--path=[The devpath of the device to query.]:sys files:_files -W /sys' \
        '*--name=[The name of the device node or a symlink to query]:device files:_files -W /dev' \
        '--root[Print absolute paths in name or symlink query.]' \
        '--attribute-walk[Print all sysfs properties of the specified device that can be used in udev rules to match the specified device]' \
        '--tree[Show tree of devices.]' \
        '--export[Print output as key/value pairs.]' \
        '--export-prefix=[Add a prefix to the key name of exported values.]:prefix' \
        '--device-id-of-file=[Print major/minor numbers of the underlying device, where the file lives on.]:files:_udevadm_mounts' \
        '--export-db[Export the content of the udev database.]' \
        '--cleanup-db[Cleanup the udev database.]' \
        '--value[When showing properties, print only their values.]' \
        '*--property=[Show only properties by this name.]:NAME' \
        '--wait-for-initialization=-[Wait for device to be initialized.]:SECS' \
        '--json=[Generate JSON output]:MODE:(pretty short off)' \
        '--no-pager[Do not pipe output into a pager.]' \
        '*--subsystem-match=[When used with --export-db, only show devices of the given subsystem.]:SUBSYSTEM' \
        '*--subsystem-nomatch=[When used with --export-db, only show devices not of the given subsystem.]:SUBSYSTEM' \
        '*--attr-match=[When used with --export-db, only show devices matching the given attribute.]:FILE[=VALUE]' \
        '*--attr-nomatch=[When used with --export-db, only show devices not matching the given attribute.]:FILE[=VALUE]' \
        '*--property-match=[When used with --export-db, only show devices matching the given property and value.]:KEY=VALUE' \
        '*--tag-match=[When used with --export-db, only show devices with the given tag.]:TAG' \
        '*--sysname-match=[When used with --export-db, only show devices with the given /sys path.]:NAME' \
        '*--name-match=[When used with --export-db, only show devices with the given name in /dev.]:device files:_files -W /dev' \
        '*--parent-match=[When used with --export-db, only show devices with the given parent device.]:sys files:_files -W /sys' \
        '--initialized-match[When used with --export-db, only show devices that are initialized.]' \
        '--initialized-nomatch[When used with --export-db, only show devices that are not initialized.]' \
        '*::devpath:_path_files -g "*(-/,-%)"'
}

