(( $+functions[_udevadm_wait_devices] )) ||
_udevadm_wait_devices(){
    # udevadm wait takes absolute paths below /dev and /sys: device nodes and their symlinks in /dev,
    # also for a name relative to /dev, and sysfs paths
    if [[ $PREFIX == /sys/* ]]; then
        _files
    elif [[ $PREFIX != /* || $PREFIX == /dev/* ]]; then
        _files -W /dev -P /dev/ -g "*(-%)"
    else
        compadd -S '' -- /dev/ /sys/
    fi
}

