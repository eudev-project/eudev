# do not edit this file, it will be overwritten on update

# these rules generate rules for persistent network device naming
#
# variables used to communicate:
#   MATCHADDR             MAC address used for the match
#   MATCHID               bus_id used for the match
#   MATCHDEVID            dev_id used for the match
#   MATCHDRV              driver name used for the match
#   MATCHIFTYPE           interface type match
#   COMMENT               comment to add to the generated rule
#   INTERFACE_NAME        requested name supplied by external tool
#   INTERFACE_NEW         new interface name returned by rule writer

ACTION!="add", GOTO="persistent_net_generator_end"
SUBSYSTEM!="net", GOTO="persistent_net_generator_end"

# ignore the interface if a name has already been set
NAME=="?*", GOTO="persistent_net_generator_end"

# device name whitelist
KERNEL!="eth*|ath*|wlan*[0-9]|msh*|ra*|sta*|ctc*|lcs*|hsi*", GOTO="persistent_net_generator_end"

# record only names that the kernel gave by enumeration (name_assign_type NET_NAME_ENUM), not the ones of
# interfaces named by userspace (NET_NAME_USER, NET_NAME_RENAMED) or predictably by the kernel
# (NET_NAME_PREDICTABLE), which do not depend on the order in which the kernel finds the interfaces; the
# attribute cannot be read on kernels before 3.17, which do not have it, nor for NET_NAME_UNKNOWN, and then
# the match fails, so that these interfaces are recorded, as before
ATTR{name_assign_type}!="1", GOTO="persistent_net_generator_end"

# ignore Xen virtual interfaces
SUBSYSTEMS=="xen", GOTO="persistent_net_generator_end"

# ignore UML virtual interfaces
DRIVERS=="uml-netdev", GOTO="persistent_net_generator_end"

# ignore the monitor interfaces of mac80211 drivers (ARPHRD_IEEE80211_RADIOTAP), which userspace adds to a
# wireless device on demand, with the MAC address of the device
KERNEL=="wlan*", ATTR{type}=="803", GOTO="persistent_net_generator_end"

# read MAC address
ENV{MATCHADDR}="$attr{address}"

# match interface type
ENV{MATCHIFTYPE}="$attr{type}"

# match interface dev_id
ATTR{dev_id}=="?*", ENV{MATCHDEVID}="$attr{dev_id}"

# These vendors are known to violate the local MAC address assignment scheme
# Interlan, DEC (UNIBUS or QBUS), Apollo, Cisco, Racal-Datacom
ENV{MATCHADDR}=="02:07:01:*", GOTO="globally_administered_whitelist"
# 3Com
ENV{MATCHADDR}=="02:60:60:*", GOTO="globally_administered_whitelist"
# 3Com IBM PC; Imagen; Valid; Cisco; Apple
ENV{MATCHADDR}=="02:60:8c:*", GOTO="globally_administered_whitelist"
# Intel
ENV{MATCHADDR}=="02:a0:c9:*", GOTO="globally_administered_whitelist"
# Olivetti
ENV{MATCHADDR}=="02:aa:3c:*", GOTO="globally_administered_whitelist"
# CMC Masscomp; Silicon Graphics; Prime EXL
ENV{MATCHADDR}=="02:cf:1f:*", GOTO="globally_administered_whitelist"
# Prominet Corporation Gigabit Ethernet Switch
ENV{MATCHADDR}=="02:e0:3b:*", GOTO="globally_administered_whitelist"
# BTI (Bus-Tech, Inc.) IBM Mainframes
ENV{MATCHADDR}=="02:e6:d3:*", GOTO="globally_administered_whitelist"
# Novell 2000
ENV{MATCHADDR}=="52:54:4c:*", GOTO="globally_administered_whitelist"
# Realtec
ENV{MATCHADDR}=="52:54:ab:*", GOTO="globally_administered_whitelist"
# Kingston Technologies
ENV{MATCHADDR}=="e2:0c:0f:*", GOTO="globally_administered_whitelist"

# do not use "locally administered" MAC address
ENV{MATCHADDR}=="?[2367abef]:*", ENV{MATCHADDR}=""

# do not use empty address
ENV{MATCHADDR}=="00:00:00:00:00:00", ENV{MATCHADDR}=""

# do not use the MAC addresses of virtual machines, whose network interfaces are enumerated in the same
# order on every boot anyway: a clone of the machine, whose interfaces get new addresses, would find their
# names taken by the rules for the old addresses, and its interfaces would get the next free names
# KVM and QEMU (52:54:00, which some old Realtek cards used too, and which cannot be told apart), and old
# versions of libvirt (54:52:00)
ENV{MATCHADDR}=="52:54:00:*|54:52:00:*", ENV{MATCHADDR}=""
# VMware
ENV{MATCHADDR}=="00:0c:29:*|00:50:56:*|00:05:69:*|00:1c:14:*", ENV{MATCHADDR}=""
# Hyper-V
ENV{MATCHADDR}=="00:15:5d:*", ENV{MATCHADDR}=""
# VirtualBox
ENV{MATCHADDR}=="08:00:27:*", ENV{MATCHADDR}=""
# Xen, for the interfaces that the SUBSYSTEMS=="xen" test above does not catch
ENV{MATCHADDR}=="00:16:3e:*", ENV{MATCHADDR}=""
# Parallels, Oracle VM, Nutanix AHV, bhyve, Proxmox VE
ENV{MATCHADDR}=="00:1c:42:*|00:21:f6:*|50:6b:8d:*|58:9c:fc:*|bc:24:11:*", ENV{MATCHADDR}=""
# Microsoft Azure (Hyper-V)
ENV{MATCHADDR}=="00:03:ff:*|00:0d:3a:*|00:1d:d8:*|00:12:5a:*|00:17:fa:*|00:22:48:*|00:25:ae:*", ENV{MATCHADDR}=""
ENV{MATCHADDR}=="00:50:f2:*|28:18:78:*|50:1a:c5:*|60:45:bd:*|7c:1e:52:*|7c:ed:8d:*|dc:b4:c4:*", ENV{MATCHADDR}=""
# Ravello
ENV{MATCHADDR}=="2c:c2:60:*", ENV{MATCHADDR}=""

LABEL="globally_administered_whitelist"

# build comment line for generated rule:
SUBSYSTEMS=="pci", ENV{COMMENT}="PCI device $attr{vendor}:$attr{device} ($driver)"
SUBSYSTEMS=="usb", ATTRS{idVendor}=="?*", ENV{COMMENT}="USB device 0x$attr{idVendor}:0x$attr{idProduct} ($driver)"
SUBSYSTEMS=="pcmcia", ENV{COMMENT}="PCMCIA device $attr{card_id}:$attr{manf_id} ($driver)"
SUBSYSTEMS=="ieee1394", ENV{COMMENT}="Firewire device $attr{host_id})"

# ibmveth likes to use "locally administered" MAC addresses
DRIVERS=="ibmveth", ENV{MATCHADDR}="$attr{address}", ENV{COMMENT}="ibmveth ($id)"

# S/390 uses id matches only, do not use the MAC address or dev_id match
SUBSYSTEMS=="ccwgroup", ENV{COMMENT}="S/390 $driver device at $id", ENV{MATCHID}="$id", ENV{MATCHDRV}="$driver", ENV{MATCHADDR}="", \
  ENV{MATCHDEVID}=""

# see if we got enough data to create a rule
ENV{MATCHADDR}=="", ENV{MATCHID}=="", ENV{INTERFACE_NAME}=="", GOTO="persistent_net_generator_end"

# default comment
ENV{COMMENT}=="", ENV{COMMENT}="net device ($attr{driver})"

# write rule
DRIVERS=="?*", IMPORT{program}="write_net_rules"

# rename interface if needed
ENV{INTERFACE_NEW}=="?*", NAME="$env{INTERFACE_NEW}"

LABEL="persistent_net_generator_end"
