ACLOCAL_AMFLAGS = -I m4 ${ACLOCAL_FLAGS}

# ------------------------------------------------------------------------------
# rule_generator - persistent network rule generator
# ------------------------------------------------------------------------------
# generated by configure from write_net_rules.in, which is in the release tarball, for the
# udevlibexecdir of the build, so not in the tarball itself
nodist_udevlibexec_SCRIPTS = \
        write_net_rules

udevhomedir = $(udevlibexecdir)
dist_udevhome_DATA = rule_generator.functions

dist_udevrules_DATA = \
        75-persistent-net-generator.rules
