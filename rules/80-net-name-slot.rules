# do not edit this file, it will be overwritten on update

ACTION!="add", GOTO="net_name_slot_end"
SUBSYSTEM!="net", GOTO="net_name_slot_end"
NAME!="", GOTO="net_name_slot_end"

IMPORT{cmdline}="net.ifnames"
ENV{net.ifnames}=="0", GOTO="net_name_slot_end"

# like the "keep" and "kernel" policies of systemd, do not rename interfaces named by userspace
# (name_assign_type NET_NAME_USER or NET_NAME_RENAMED), or predictably by the kernel (NET_NAME_PREDICTABLE)
ATTR{name_assign_type}=="2|3|4", GOTO="net_name_slot_end"

# rename the interface to the first valid interface name of these, like ifname_valid() of systemd:
# 1 to 15 characters, not only digits, not ".", "..", "all" or "default", and only printable ASCII
# characters other than space, ':', '/' and '%'
NAME=="", ENV{ID_NET_NAME_FROM_DATABASE}=="*[!0-9]*", ENV{ID_NET_NAME_FROM_DATABASE}!="????????????????*|.|..|all|default|*[!!-~]*|*[:/%]*", NAME="$env{ID_NET_NAME_FROM_DATABASE}"
NAME=="", ENV{ID_NET_NAME_ONBOARD}=="*[!0-9]*", ENV{ID_NET_NAME_ONBOARD}!="????????????????*|.|..|all|default|*[!!-~]*|*[:/%]*", NAME="$env{ID_NET_NAME_ONBOARD}"
NAME=="", ENV{ID_NET_NAME_SLOT}=="*[!0-9]*", ENV{ID_NET_NAME_SLOT}!="????????????????*|.|..|all|default|*[!!-~]*|*[:/%]*", NAME="$env{ID_NET_NAME_SLOT}"
NAME=="", ENV{ID_NET_NAME_PATH}=="*[!0-9]*", ENV{ID_NET_NAME_PATH}!="????????????????*|.|..|all|default|*[!!-~]*|*[:/%]*", NAME="$env{ID_NET_NAME_PATH}"
NAME=="", ENV{ID_NET_NAME_MAC}=="*[!0-9]*", ENV{ID_NET_NAME_MAC}!="????????????????*|.|..|all|default|*[!!-~]*|*[:/%]*", ENV{ID_NET_NAME_MAC}!="??x000000000000", NAME="$env{ID_NET_NAME_MAC}"

LABEL="net_name_slot_end"
