ACLOCAL_AMFLAGS = -I m4 ${ACLOCAL_FLAGS}

EXTRA_DIST = \
	64-btrfs.rules.in

CLEANFILES = \
	64-btrfs.rules \
	64-btrfs.rules.tmp

dist_udevrules_DATA = \
	50-udev-default.rules \
	60-autosuspend.rules \
	60-block.rules \
	60-cdrom_id.rules \
	60-dmi-id.rules \
	60-drm.rules \
	60-evdev.rules \
	60-fido-id.rules \
	60-gpiochip.rules \
	60-infiniband.rules \
	60-input-id.rules \
	60-persistent-alsa.rules \
	60-persistent-hidraw.rules \
	60-persistent-input.rules \
	60-persistent-media-controller.rules \
	60-persistent-storage-mtd.rules \
	60-persistent-storage-tape.rules \
	60-persistent-v4l.rules \
	60-sensor.rules \
	60-serial.rules \
	65-integration.rules \
	70-camera.rules \
	70-joystick.rules \
	70-memory.rules \
	70-mouse.rules \
	70-touchpad.rules \
	75-net-description.rules \
	78-sound-card.rules \
	81-net-dhcp.rules \
	90-image-dissect.rules

# generated from 64-btrfs.rules.in for the bindir of the build, so not in the release tarball
nodist_udevrules_DATA = \
	64-btrfs.rules

# the variant for --with-net-ifnames-default: both are generated by tools/gen-net-naming-rules.py, and
# installed without the directory; the rule generator replaces 80-net-name-slot.rules, except with no,
# where it records no names with net.ifnames=1, when 80-net-name-slot.rules renames the interfaces
if NET_IFNAMES_DEFAULT_NO
dist_udevrules_DATA += \
	net-ifnames-no/80-net-altnames.rules \
	net-ifnames-no/80-net-name-slot.rules
else
dist_udevrules_DATA += \
	80-net-altnames.rules
if !ENABLE_RULE_GENERATOR
dist_udevrules_DATA += \
	80-net-name-slot.rules
endif
endif

EXTRA_DIST += \
	80-net-altnames.rules \
	80-net-name-slot.rules \
	net-ifnames-no/80-net-altnames.rules \
	net-ifnames-no/80-net-name-slot.rules

if HAVE_BLKID
dist_udevrules_DATA += \
	60-persistent-storage.rules
endif

if HAVE_KMOD
dist_udevrules_DATA += \
	80-drivers.rules
endif

if ENABLE_MTD_PROBE
dist_udevrules_DATA += \
	75-probe_mtd.rules
endif

if ENABLE_TPM2
dist_udevrules_DATA += \
	60-tpm2-id.rules
endif

do_subst = $(SED) \
	-e 's,{{ROOTBINDIR}},$(bindir),g'

64-btrfs.rules: $(srcdir)/64-btrfs.rules.in Makefile
	$(AM_V_GEN)$(do_subst) $(srcdir)/64-btrfs.rules.in > 64-btrfs.rules.tmp && \
		mv -f 64-btrfs.rules.tmp 64-btrfs.rules

install-data-local:
	$(MKDIR_P) $(DESTDIR)$(udevconfdir)/rules.d
